# Base PostgreSQL avec l'extension pgvector (Supabase)
DATABASE_URL=

# LLM (https://console.groq.com)
GROQ_API_KEY=

# Embeddings (https://jina.ai)
JINA_API_KEY=

# Clé exigée pour ajouter des produits (en-tête x-admin-key).
# Générer une valeur longue et aléatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_API_KEY=
